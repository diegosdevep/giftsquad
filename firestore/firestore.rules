rules_version = '2';

// Reglas que sostienen el principio rector de GiftSquad:
// "El destinatario nunca conoce quién reservó qué, ni quién aportó cuánto."
//
// Pilares de seguridad:
//   1. /reservations:                 el itemOwner NO puede leer reservas sobre sus ítems.
//   2. /secretSantaEvents/{id}/assignments/{uid}: solo {uid} puede leer su asignación.
//   3. /items/{id}/private/{doc}:     las notas privadas del dueño viven en subcolección
//                                     aparte, no como campo del ítem — así ningún otro
//                                     miembro del grupo puede leerlas, ni siquiera a
//                                     nivel de documento crudo (Firestore no filtra por
//                                     campos dentro de un mismo doc).
//   4. /history/{id}/givers/{uid}:    quién aportó a un regalo vive en subcolección,
//                                     legible solo por {uid} — ni el destinatario ni el
//                                     resto del grupo pueden leer la lista de aportantes.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isMember(groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    // El dueño de un grupo puede sumar a OTRO usuario a ese grupo (feature "agregar
    // amigo por @usuario/email/código"). Solo se le permite AGREGAR un id de grupo
    // propio a groupIds — nunca borrar entradas ni tocar cualquier otro campo del
    // documento ajeno.
    function isGroupOwnerAddingMember() {
      let oldIds = resource.data.groupIds;
      let newIds = request.resource.data.groupIds;
      let added = newIds.removeAll(oldIds);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds']) &&
             newIds.hasAll(oldIds) &&
             added.size() == 1 &&
             get(/databases/$(database)/documents/groups/$(added[0])).data.ownerId == uid();
    }

    // ---------- /users ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (
        uid() == userId ||
        isGroupOwnerAddingMember()
      );
      allow delete: if false;
    }

    // ---------- /groups ----------
    match /groups/{groupId} {
      // El owner siempre puede leer sus propios grupos (necesario para la query de
      // "nombre de grupo repetido" filtrada por ownerId al crear un grupo nuevo).
      allow read: if isSignedIn() && (
        uid() in resource.data.memberIds ||
        resource.data.ownerId == uid()
      );
      // Cualquier user autenticado puede crearlo si se incluye como miembro y owner.
      allow create: if isSignedIn() &&
                       request.resource.data.ownerId == uid() &&
                       uid() in request.resource.data.memberIds;
      // Permitir que cualquier user se sume a sí mismo (joinGroup); el owner puede
      // editar metadata. Para evitar abuso, solo se aceptan cambios que SUMEN al
      // usuario actual o que el owner ejecute.
      allow update: if isSignedIn() && (
        // owner edita libremente
        uid() == resource.data.ownerId ||
        // el propio user se suma o se va
        (request.resource.data.memberIds.hasOnly(resource.data.memberIds.concat([uid()])) ||
         request.resource.data.memberIds == resource.data.memberIds.removeAll([uid()]))
      );
      allow delete: if isSignedIn() && uid() == resource.data.ownerId;
    }

    // ---------- /items ----------
    match /items/{itemId} {
      allow read: if isSignedIn() && (
        uid() == resource.data.ownerId ||
        // Algún grupo del ítem coincide con un grupo del usuario.
        // Como Firestore no iterando, exigimos que el cliente filtre via query
        // (.whereField("groupIds", arrayContains: groupId)) — la regla mínima
        // verifica que el viewer comparta al menos uno declarado.
        resource.data.groupIds.hasAny(get(/databases/$(database)/documents/users/$(uid())).data.groupIds)
      );
      allow create: if isSignedIn() &&
                       request.resource.data.ownerId == uid();
      allow update, delete: if isSignedIn() && uid() == resource.data.ownerId;

      // Notas privadas del dueño ("comprala en tal talle", etc.) — nunca deben
      // ser visibles para el resto del grupo, así que viven fuera del doc del
      // ítem y solo el dueño puede leer/escribir esta subcolección.
      match /private/{docId} {
        allow read, write: if isSignedIn() &&
                               uid() == get(/databases/$(database)/documents/items/$(itemId)).data.ownerId;
      }
    }

    // ---------- /itemLocks ----------
    // Espejo liviano de "¿este ítem ya está tomado?" que cubre TODOS los grupos
    // donde el ítem es visible — sin esto, un ítem compartido en dos grupos se
    // podía reservar dos veces (una por grupo), porque /reservations solo es
    // legible por miembros del grupo puntual donde se hizo la reserva. Solo lo
    // escriben las Cloud Functions (onReservationCreated y sus liberaciones);
    // nunca guarda reservedBy, así que no rompe el anonimato ni agrega una vía
    // nueva para que el dueño se entere de quién fue.
    match /itemLocks/{itemId} {
      allow read: if isSignedIn() &&
                     (resource == null ||
                      (uid() != resource.data.itemOwnerId &&
                       resource.data.groupIds.hasAny(get(/databases/$(database)/documents/users/$(uid())).data.groupIds)));
      allow write: if false;
    }

    // ---------- /reservations ----------
    match /reservations/{resId} {
      // ANONIMATO: el dueño del ítem NO puede leer la reserva. La regla de create
      // ya garantiza reservedBy != itemOwnerId siempre, así que dejar leer las
      // propias (para la pantalla "Mis reservas") nunca puede filtrarle al dueño
      // quién reservó su ítem.
      allow read: if isSignedIn() &&
                     (uid() == resource.data.reservedBy ||
                      (uid() != resource.data.itemOwnerId &&
                       isMember(resource.data.groupId)));
      allow create: if isSignedIn() &&
                       request.resource.data.reservedBy == uid() &&
                       request.resource.data.itemOwnerId != uid() &&
                       isMember(request.resource.data.groupId) &&
                       !exists(/databases/$(database)/documents/itemLocks/$(request.resource.data.itemId));
      // Solo el que reservó puede liberarla / actualizar status.
      allow update: if isSignedIn() &&
                       resource.data.reservedBy == uid() &&
                       uid() != resource.data.itemOwnerId;
      allow delete: if isSignedIn() && resource.data.reservedBy == uid();
    }

    // ---------- /secretSantaEvents ----------
    match /secretSantaEvents/{eventId} {
      allow read: if isSignedIn() &&
                     (uid() in resource.data.participantIds ||
                      uid() == resource.data.createdBy);
      // Independiente de los grupos: el organizador arma la lista de
      // invitados a mano, no hace falta compartir un grupo con ellos. Con 2
      // participantes no hay secreto (A le regala a B y B le regala a A,
      // ambos lo saben) — antes esto solo lo validaba el cliente (el botón
      // se deshabilitaba), así que un request armado a mano podía
      // saltárselo igual.
      allow create: if isSignedIn() &&
                       request.resource.data.createdBy == uid() &&
                       request.resource.data.participantIds.size() >= 3;
      allow update: if isSignedIn() &&
                       uid() == resource.data.createdBy;
      allow delete: if isSignedIn() &&
                       uid() == resource.data.createdBy;

      // ANONIMATO: cada user solo lee SU asignación. Las escribe el server
      // (la Cloud Function que ejecuta el sorteo).
      match /assignments/{assigneeId} {
        allow read: if isSignedIn() && uid() == assigneeId;
        allow write: if false;
      }

      // Preferencia individual "mostrarle mi lista a quien me regale a mí"
      // (configurable en cualquier momento, no solo al aceptar). Solo otros
      // participantes del mismo evento pueden leerla — no es información
      // sensible, pero tampoco hace falta exponerla a cualquiera.
      match /participants/{participantId} {
        allow read: if isSignedIn() &&
                       uid() in get(/databases/$(database)/documents/secretSantaEvents/$(eventId)).data.participantIds;
        allow write: if isSignedIn() && uid() == participantId;
      }
    }

    // ---------- /history ----------
    match /history/{entryId} {
      // El documento padre (ítem, fecha, monto) es un reporte compartido del
      // grupo. ANONIMATO: quién aportó específicamente NO es un campo de este
      // doc — vive en /history/{id}/givers/{uid}, legible solo por ese uid.
      allow read: if isSignedIn() && (
        uid() == resource.data.recipientId ||
        isMember(resource.data.groupId)
      );
      allow create, update: if false; // solo Cloud Functions
      // Cualquiera que pueda ver la entrada la puede borrar (limpieza de
      // historial, no hay dueño único de un registro compartido).
      allow delete: if isSignedIn() && (
        uid() == resource.data.recipientId ||
        isMember(resource.data.groupId)
      );

      match /givers/{giverId} {
        allow read: if isSignedIn() && uid() == giverId;
        allow write: if false; // solo Cloud Functions
      }
    }

    // ---------- /notifications ----------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && uid() == resource.data.userId;
      allow update: if isSignedIn() && uid() == resource.data.userId; // marcar como leídas
      allow create, delete: if false; // las crean Cloud Functions
    }
  }
}
