    "Buscá a cualquier persona con cuenta en GiftSquad — no hace falta que compartan un grupo. Hacen falta al menos 3 para que el sorteo tenga sentido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for anyone with a GiftSquad account — you don't need to share a group. At least 3 people are needed for the draw to make sense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscá a cualquier persona con cuenta en GiftSquad — no hace falta que compartan un grupo. Hacen falta al menos 3 para que el sorteo tenga sentido."
          }
        }
